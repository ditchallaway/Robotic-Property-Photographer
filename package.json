    "pngjs": "^7.0.0",
    "puppeteer": "^24.34.0",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "eslint": "^8",
    "eslint-config-next": "13.5.6"
  }
}
