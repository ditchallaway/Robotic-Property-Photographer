# Moonshot Renderer Environment Variables

# Google 3D Tiles API
GOOGLE_API_KEY=your_google_api_key_here

# Cesium Ion Token (optional, for Cesium resources)
CESIUM_ION_TOKEN=your_cesium_token_here

# Server Configuration
PORT=3000
NODE_ENV=production

# Renderer Timeouts (ms)
RENDER_TIMEOUT=120000
TILE_LOAD_TIMEOUT=120000

# Black Frame Detection Threshold (0-1, where 1 = 100% black pixels)
BLACK_FRAME_THRESHOLD=0.95

# Puppeteer Launch Args (space-separated if multiple)
PUPPETEER_HEADLESS=true
