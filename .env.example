# Robotic Property Photographer Configuration Example

# Base Layer Provider: 'google-3d' (default) or 'azure-maps'
BASE_LAYER_PROVIDER=google-3d

# Google 3D Tiles API (required when BASE_LAYER_PROVIDER=google-3d)
GOOGLE_API_KEY=your_google_api_key_here

# Azure Maps (required when BASE_LAYER_PROVIDER=azure-maps)
AZURE_MAPS_KEY=your_azure_maps_key_here

# Cesium Ion Token (required when BASE_LAYER_PROVIDER=azure-maps for world terrain)
CESIUM_ION_TOKEN=your_cesium_token_here

# Server Configuration
PORT=9876
NODE_ENV=production

# ntfy.sh Topic for notifications
NTFY_TOPIC=to-human-bt-test

# Renderer Timeouts (ms)
RENDER_TIMEOUT=1200000
SHOT_TILE_TIMEOUT_MS=120000

# Black Frame Detection Threshold (0-1, where 1 = 100% black pixels)
BLACK_FRAME_THRESHOLD=0.95

# Puppeteer Launch Args
PUPPETEER_HEADLESS=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
