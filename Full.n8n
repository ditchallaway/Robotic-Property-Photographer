      {
        "parameters": {
          "jsCode": "// Loop over all incoming items\nconst items = $input.all();\nconst result = [];\nfor (const item of items) {\n  // 1. Get the image URL from the incoming data \n  // (Change 'imageUrl' to match your actual input field name)\n  const imageUrl = item.json.imageUrl;\n  \n  if (!imageUrl) {\n    // Pass the item through unchanged if there's no image URL\n    result.push({ json: item.json });\n    continue;\n  }\n  \n  // 2. Build the Photopea API compliant JSON configuration\n  const photopeaConfig = {\n    files: [\n      imageUrl\n    ],\n    // Optional: you can add environment settings like a custom save endpoint\n    // environment: {\n    //   customIO: {\n    //     save: \"https://your-webhook-to-receive-saved-images.com/\"\n    //   }\n    // }\n  };\n  \n  // 3. Serialize and encode the JSON\n  const configString = JSON.stringify(photopeaConfig);\n  const encodedConfig = encodeURIComponent(configString);\n  \n  // 4. Construct the final URL pointing to your hosted editor\n  const finalUrl = `https://app.brokertricks.com/editor.html#${encodedConfig}`;\n  \n  // 5. Output the results\n  result.push({\n    json: {\n      ...item.json,            // Keep all original incoming data\n      photopeaUrl: finalUrl,   // Add the generated URL\n      photopeaConfig: photopeaConfig // (Optional) Output the raw config for debugging\n    }\n  });\n}\nreturn result;"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
