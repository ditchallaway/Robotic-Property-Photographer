        208,
        -48
      ],
      "id": "1510e24a-b6e6-4fdb-8971-8294f439774b",
      "name": "Edit Fields3"
    },
    {
      "parameters": {
        "jsCode": "// Loop over all incoming items\nconst items = $input.all();\nconst result = [];\nfor (const item of items) {\n  // 1. Extract your variables (Update these field names if they differ in your n8n data)\n  const imageUrl = item.json.imageUrl;\n  const customerId = item.json.customer_id || \"unknown_cust\";\n  const orderId = item.json.order_id || \"unknown_order\";\n  const direction = item.json.direction || \"unknown_dir\";\n  const acreage = item.json.acreage || \"Acreage N/A\";\n  \n  if (!imageUrl) {\n    result.push({ json: item.json });\n    continue;\n  }\n  // 2. Build the ExtendScript to execute inside Photopea\n  // This opens the image as a layer, updates the text on Layer 1, and runs the action.\n  const extendScript = `\n    // The PSD template is already open and active.\n    \n    // Step A: Load the boundary image as a Smart Object onto Layer 0\n    // The \"true\" parameter tells Photopea to open it as a layer in the current document.\n    app.open(\"${imageUrl}\", null, true);\n    // Step B: Update the placeholder text on Layer 1\n    // (Note: layers are 0-indexed in scripts, but order depends on your PSD structure. \n    // Assuming the text layer is named \"TextLayer\" or you can access by index).\n    var doc = app.activeDocument;\n    \n    // Safety check: Find the layer by name, or just use index 1 if it's strictly the second layer\n    try {\n      doc.layers[1].textItem.contents = \"${acreage}\";\n    } catch(e) {\n      // Fallback if layer[1] isn't a text layer\n      alert(\"Could not update text layer. Please check PSD layer order.\");\n    }\n    // Step C: Run your pre-recorded action\n    app.doAction(\"Action 0\", \"Action Set 0\");\n  `;\n  \n  // 3. Build the complete Photopea API JSON payload\n  const photopeaConfig = {\n    // Files to load first (Actions and your blank PSD template)\n    files: [\n      \"https://app.brokertricks.com/actions.atn\",\n      \"https://app.brokertricks.com/template.psd\" \n    ],\n    // The webhook endpoint where Photopea will POST the final image when they hit \"Save\"\n    server: {\n      url: `https://auto.brokertricks.com/webhook/bucket?customer_id=${customerId}&order_id=${orderId}&direction=${direction}`,\n      formats: [\"png\"] // We only want the final flat PNG for the dataset\n    },\n    // The script to run immediately after the files are loaded\n    script: extendScript\n  };\n  \n  // 4. Serialize and encode the JSON\n  const configString = JSON.stringify(photopeaConfig);\n  const encodedConfig = encodeURIComponent(configString);\n  \n  // 5. Construct the final direct URL pointing to the official Photopea app\n  const finalUrl = `https://www.photopea.com#${encodedConfig}`;\n  \n  // 6. Output the results\n  result.push({\n    json: {\n      ...item.json,\n      photopeaEditorUrl: finalUrl // Provide this link to your human editor!\n    }\n  });\n}\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1392,
        -640
      ],
      "id": "6698e43b-129a-4d48-aeb5-5ecea88c5def",
      "name": "Code in JavaScript1",
      "disabled": true
    },
    {
      "parameters": {
        "height": 352,
        "width": 192,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -1184,
        -240
      ],
      "id": "d2a39ae3-7387-4178-b634-62947b19ef81",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst input = items[0].json;\n\nconst customer_id = input.customer_id || 'cust_12345';\nconst order_id = input.order_id || 'order_12345';\n\nlet acreage = \"0\";\ntry {\n    acreage = $('Edit Fields1').first().json.acres;\n} catch(e) {\n    acreage = input.acreage || \"0\";\n}\n\n// Dynamically build files array from all incoming items\n// Filter out reference images — they are srcmap downloads, not property shots\nconst files = [];\nfor (const item of items) {\n  if (item.json.imageUrl && !item.json.imageUrl.includes('reference_')) {\n    files.push(item.json.imageUrl);\n  }\n}\n\n// Fallback in case no imageUrls were passed\nif (files.length === 0) {\n  files.push(`https://pics.brokertricks.com/${customer_id}/${order_id}/property_overhead.png`);\n}\n\nconst webhookUrl = `https://auto.brokertricks.com/webhook/bucket?customer_id=${customer_id}&order_id=${order_id}&direction=full`;\n\n// Build ExtendScript that loops over ALL open documents\n// Photopea opens each file as a separate tab — we must iterate\n// through every document to add the acreage text layer to each one.\nconst script = `\nvar acreageText = \"${acreage} ACRES\";\nfor (var i = 0; i < app.documents.length; i++) {\n  app.activeDocument = app.documents[i];\n  var doc = app.activeDocument;\n\n  var textLayer = doc.artLayers.add();\n  textLayer.kind = LayerKind.TEXT;\n  textLayer.textItem.contents = acreageText;\n  textLayer.textItem.size = 120;\n\n  var col = new SolidColor();\n  col.rgb.hexValue = \"FFFF00\";\n  textLayer.textItem.color = col;\n  textLayer.textItem.position = [100, 200];\n}\n`.trim();\n\nconst payload = {\n    files: files,\n    server: {\n        url: webhookUrl,\n        formats: [\"png\"]\n    },\n    script: script\n};\n\nconst encodedConfig = encodeURIComponent(JSON.stringify(payload));\n\n// Add query params for the dashboard UI, and the hash for Photopea\nconst params = [\n  `customer_id=${encodeURIComponent(customer_id)}`,\n  `order_id=${encodeURIComponent(order_id)}`,\n  `direction=full`,\n  `acreage=${encodeURIComponent(acreage)}`\n];\nconst editorUrl = `https://app.brokertricks.com/editor-full.html?${params.join('&')}#${encodedConfig}`;\n\n// We only need to output a single item containing the combined URL\nreturn [\n  {\n    json: {\n      ...input,\n      editorUrl: editorUrl,\n      photopeaPayload: payload,\n      filesIncluded: files.length\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        96
      ],
      "id": "86111bf4-e49e-43e8-962d-f759220c0b3c",
      "name": "all images url builder"
    },
    {
      "parameters": {
        "jsCode": "// Loop over all incoming items\nconst items = $input.all();\nconst result = [];\nfor (const item of items) {\n  const imageUrl = item.json.imageUrl;\n  const customerId = item.json.customer_id || \"unknown_cust\";\n  const orderId = item.json.order_id || \"unknown_order\";\n  const direction = (item.json.direction || \"unknown\").toLowerCase();\n  const acreage = item.json.acreage || \"0.302 acres\"; \n  \n  if (!imageUrl) {\n    result.push({ json: item.json });\n    continue;\n  }\n  // 1. Load the image as a layer\n  let extendScript = `\n    var doc = app.activeDocument;\n    \n    // Safety check to ensure it goes above the bottom layer\n    try { doc.activeLayer = doc.layers[doc.layers.length - 1]; } catch(e) {}\n    \n    app.open(\"${imageUrl}\", null, true);\n  `;\n  // 2. Branch logic based on direction\n  if (direction === \"overhead\") {\n    // OVERHEAD: Run the action, calculate the path angle, and align text automatically\n    extendScript += `\n      app.doAction(\"Action 0\", \"Action Set 0\");\n      if (doc.pathItems.length > 0) {\n        var sub = doc.pathItems[0].subPathItems[0].pathPoints;\n        var best = {len:0, ang:0, p1:[0,0], p2:[0,0]};\n        \n        for (var i=0; i < sub.length-1; i++) {\n          var a = sub[i].anchor, b = sub[i+1].anchor;\n          var dx = b[0]-a[0], dy = b[1]-a[1];\n          var len = Math.hypot(dx,dy), ang = Math.atan2(dy,dx);\n          if (len > best.len) best = {len:len, ang:ang, p1:a, p2:b};\n        }\n        \n        var mx = (best.p1[0] + best.p2[0]) / 2;\n        var my = (best.p1[1] + best.p2[1]) / 2;\n        var ox = -30 * Math.sin(best.ang);\n        var oy = 30 * Math.cos(best.ang);\n            \n        // THE PROVEN TEXT INJECTION BLOCK\n        var tl = doc.artLayers.add(); \n        tl.kind = LayerKind.TEXT;\n        tl.textItem.contents = \"${acreage}\";\n        \n        var col = new SolidColor(); \n        col.rgb.hexValue = \"FFFF00\";\n        tl.textItem.color = col;\n        tl.textItem.size = 80;\n        tl.textItem.baselineShift = -160;\n        tl.textItem.justification = Justification.CENTER;\n        tl.textItem.position = [mx + ox, my + oy];\n        \n        var deg = best.ang * (180/Math.PI);\n        if (deg > 90 || deg < -90) deg += 180;\n        tl.rasterize(); \n        tl.rotate(deg, AnchorPosition.MIDDLECENTER);\n      }\n    `;\n  } else {\n    // CARDINAL VIEWS: Skip the action/math, but still use the proven text injection \n    // so the editor doesn't have to type it manually.\n    extendScript += `\n      // THE PROVEN TEXT INJECTION BLOCK (Flat placement)\n      var tl = doc.artLayers.add(); \n      tl.kind = LayerKind.TEXT;\n      tl.textItem.contents = \"${acreage}\" + \" acres\";\n      \n      var col = new SolidColor(); \n      col.rgb.hexValue = \"FFFF00\";\n      tl.textItem.color = col;\n      tl.textItem.size = 80;\n      tl.textItem.baselineShift = 0;\n      tl.textItem.justification = Justification.CENTER;\n      \n      // Spawn it near the center of the canvas (assuming ~1200px map size)\n      tl.textItem.position = [600, 600]; \n    `;\n  }\n  // 3. Build the Photopea API JSON payload\n  const photopeaConfig = {\n    files: [\n      \"https://app.brokertricks.com/action.atn\",\n      \"https://app.brokertricks.com/template.psd\" \n    ],\n    server: {\n      url: `https://auto.brokertricks.com/webhook/bucket?customer_id=${customerId}&order_id=${orderId}&direction=${direction}`,\n      formats: [\"png\"] \n    },\n    script: extendScript\n  };\n  \n  // 4. Serialize and encode the JSON\n  const configString = JSON.stringify(photopeaConfig);\n  const encodedConfig = encodeURIComponent(configString);\n  const finalUrl = `https://www.photopea.com#${encodedConfig}`;\n  \n  result.push({\n    json: {\n      ...item.json,\n      photopeaEditorUrl: finalUrl\n    }\n  });\n}\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        336
      ],
      "id": "1227539a-c169-4190-ba56-a8680c5162de",
      "name": "single image edit urls"
    },
    {
      "parameters": {
        "jsCode": "/**\n * Photopea URL Builder — n8n Code Node\n * \n * Generates editor URLs for the embedded Photopea page at app.brokertricks.com.\n * Each URL opens a specific property image in the editor with:\n * - The action set (.atn) pre-loaded for boundary \"pop\" effects\n * - An acreage text layer automatically placed (yellow #FFFF00, 120pt)\n * - One URL per image — each opens in its own browser tab\n *\n * The editor page fetches images from R2 as ArrayBuffers, bypassing CORS\n * entirely since Photopea never makes the cross-origin request itself.\n *\n * MODE: \"Run Once for All Items\"\n *\n * EXPECTED INPUT ($input.first().json):\n *   customer_id  — e.g. \"cust_12345\"\n *   order_id     — e.g. \"order_12345\"\n *   product_id   — \"single_overhead\" | \"single_north\" | \"full\"\n *   acreage      — e.g. \"5.00 ACRES\"\n *\n * OUTPUT: Array of { direction, imageUrl, editorUrl } objects\n */\n\n// ── Config ─────────────────────────────────────────────────────��������─\nconst EDITOR_BASE  = \"https://app.brokertricks.com/editor.html\";\nconst R2_BASE      = \"https://pics.brokertricks.com\";\n\n// Product → which shots get URLs\nconst PRODUCT_SHOTS = {\n  single_overhead: [\"overhead\"],\n  single_north:    [\"north\"],\n  full:            [\"north\", \"east\", \"south\", \"west\", \"overhead\"],\n};\n\n// ── Input ──────────────────────────────────────────────────────────���\nconst data = $input.first().json;\n\n// Support both direct fields and webhook .body nesting\nconst input = data.body || data;\n\nconst customer_id = input.customer_id;\nconst order_id    = input.order_id;\nconst product_id  = input.product_id || \"full\";\nconst acreage     = input.acreage    || \"\";\n\n// Validate required fields\nif (!customer_id || !order_id) {\n  return [{\n    json: {\n      error: \"Missing required fields: customer_id and order_id\",\n      customer_id,\n      order_id,\n    }\n  }];\n}\n\n// Resolve shot list from product type\nconst shots = PRODUCT_SHOTS[product_id];\nif (!shots) {\n  return [{\n    json: {\n      error: `Unknown product_id: \"${product_id}\". Expected: ${Object.keys(PRODUCT_SHOTS).join(\", \")}`,\n      product_id,\n    }\n  }];\n}\n\n// ── Build Editor URLs ──���─────────��─�������─────────────────────────────\n\nfunction buildEditorUrl(direction, customerId, orderId, acreageText) {\n  const params = [];\n  params.push(`customer_id=${encodeURIComponent(customerId)}`);\n  params.push(`order_id=${encodeURIComponent(orderId)}`);\n  params.push(`direction=${encodeURIComponent(direction)}`);\n\n  // Tell the editor where to POST the final saved image\n  const webhookUrl = `https://auto.brokertricks.com/webhook/bucket?customer_id=${customerId}&order_id=${orderId}&direction=${direction}`;\n  params.push(`server_url=${encodeURIComponent(webhookUrl)}`);\n\n  // Only include acreage if present\n  if (acreageText) {\n    params.push(`acreage=${encodeURIComponent(acreageText)}`);\n  }\n\n  return `${EDITOR_BASE}?${params.join('&')}`;\n}\n\n\n// ── Generate output ─────────────────────────────────────────────────\nconst results = shots.map(direction => {\n  const imageUrl  = `${R2_BASE}/${customer_id}/${order_id}/property_${direction}.png`;\n  const editorUrl = buildEditorUrl(direction, customer_id, order_id, acreage);\n\n  return {\n    json: {\n      direction,\n      imageUrl,\n      editorUrl,\n      customer_id,\n      order_id,\n      product_id,\n      acreage,\n    }\n  };\n});\n\nreturn results;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        -176
      ],
      "id": "8b27d8f6-8845-4c49-8eb4-90865a9a558f",
      "name": "single imagewith dash"
    }
